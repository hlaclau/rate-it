# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare common text files
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.env text eol=lf
Makefile text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
